{
  "name": "petify",
  "version": "0.1.0",
  "description": "Einheitliche Tierheim-API und Persönlichkeitstest für passende Tierheimtiere",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.js",
    "db:reset": "node --env-file-if-exists=.env scripts/db-setup.js --reset",
    "test": "node --env-file-if-exists=.env --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
