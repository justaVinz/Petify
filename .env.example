# PostgreSQL-Verbindung
DATABASE_URL=postgres://virony:virony@localhost:5432/pfotenmatch
PORT=3200
# Geheimer Schlüssel zum Anlegen von Tierheimen (Verwaltung)
ADMIN_TOKEN=bitte-aendern
# Öffentliche Adresse der App (für Login-Links und Google-Weiterleitung)
APP_URL=http://localhost:3200
# Versand der Login-Links per SMTP, z. B. smtp://benutzer:passwort@smtp.example.org:587
# Ohne SMTP_URL werden Links nur im Server-Log ausgegeben (Entwicklung).
SMTP_URL=
MAIL_FROM=Pfotenmatch <login@pfotenmatch.example>
# Google-Login (Google Cloud Console → OAuth-Client "Webanwendung",
# Weiterleitungs-URI: APP_URL/auth/google/callback). Leer = Google-Button ausgeblendet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ablage für hochgeladene Fotos
UPLOAD_DIR=./uploads
